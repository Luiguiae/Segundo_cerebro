# Python
__pycache__/
*.pyc
*.log
# Logs rotados (RotatingFileHandler del daemon: jarvis.log.1, .2, .3 — ~5 MB c/u).
# `*.log` no los cubre porque terminan en ".1", no en ".log". Patrón numérico a
# propósito: no oculta jarvis.log.archived, que sí está trackeado.
*.log.[0-9]*

# Secretos — nunca deben trackearse desde ninguna subcarpeta
**/.env
**/.env.*
!**/.env.example
.git-credentials

# Exports y binarios
Documentos/Presentaciones/exports/
*.pdf
*.pptx
*.key
*.mp4
*.mov

# Remotion (código fuente del renderer — no pertenece al vault)
remotion/

# Jarvis runtime
*.pid
*.onnx
*.jpg
context.md

# DS_Store
.DS_Store
